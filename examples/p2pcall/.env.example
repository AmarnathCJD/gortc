API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627
SESSION_STRING=

# Authenticate via SESSION_STRING above, or a session file at
# examples/p2pcall/session.dat (created on first interactive login).
# Generate a string session from https://session.gogram.fun

# TARGET: who to call on startup (@username or numeric user id).
# Leave empty to only wait for and auto-answer incoming calls.
TARGET=

# MEDIA: audio/video streamed into the call once connected (needs ffmpeg on PATH).
# Accepts a local file path OR an http(s) URL. If unset, a built-in sample
# audio URL is used, so you can run with no media setup at all.
MEDIA=
